# Origin of the HPTRS FastAPI backend — no trailing slash, no path.
#
# The NEXT_PUBLIC_ prefix is required, not cosmetic: src/lib/api.ts runs in the
# browser, and Next.js inlines ONLY NEXT_PUBLIC_* variables into the client
# bundle. A variable named without it (this file once documented one) is
# undefined client-side, and the app falls back to localhost in every build.
#
# Inlined at BUILD time. Setting it in a hosting dashboard requires a redeploy,
# not a restart — this is the usual reason "I set the env var and nothing
# changed".
#
# Local backend:  http://localhost:8000    (uvicorn / the Docker image's port)
# Hosted backend: https://p01--hprs-service--drrzf9ppn4dl.code.run
#
# Must be HTTPS whenever this app is served over HTTPS. A plain-http API is
# blocked as mixed content, which src/lib/api.ts reports explicitly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Payments are handled by the backend via Paystack. Ensure the backend has
# PAYSTACK_SECRET_KEY / PAYSTACK_PUBLIC_KEY set (test keys in development),
# PAYMENTS_ENABLED=true, and FRONTEND_URL pointing at this app's origin so the
# payment callback returns here.
